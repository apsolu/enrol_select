{{!
    @template enrol_select/administration_college_rule

    Template Moodle pour afficher les règles de programmation des quotas de voeux par population.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * collegelist
        * taskid
        * population
        * maxwish
        * minregister
        * maxregister

    Example context (json):
    {
        "college_list" : []
    }
}}
<ul>
{{#collegelist}}
    <li class="edit_rule" data-taskid={{ taskid }} ><strong>{{{ population }}}</strong><i class="fa-solid fa-arrow-right-long m-2"></i><span>{{#str}}planned_college_rule, enrol_select, {"maxwish": {{maxwish}}, "minregister": {{minregister}}, "maxregister": {{maxregister}} } {{/str}}</span><i class="fa fa-regular fa-gear"></i></li>
{{/collegelist}}
</ul>