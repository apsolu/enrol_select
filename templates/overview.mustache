{{!
    @template enrol_select/overview

    Template Moodle pour afficher la liste des cours ouverts aux inscriptions.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * count_activities
    * activities
        * description
        * name
        * sportid
        * info_pix_url
        * courses
            * enroled
            * enrolid
            * allow_enrolment
            * grouping
            * sport
            * event
            * weekday_locale
            * starttime
            * endtime
            * skill
            * area
            * longitude
            * latitude
            * location
            * city
            * role_options
                * localname
                * shortname
            * left_places_style
            * left_places_str

    Example context (json):
    {
        "count_activities": 0,
        "marker_pix_url": "data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs="
    }
}}
{{! Balise HTML pour gérer l'affichage de la carte OSM. }}
<div id="apsolu-location-map"></div>
<div><img style="display: none;" class="icon" id="apsolu-location-marker-img" alt="carte" src="{{marker_pix_url}}"></div>

<div id="apsolu-activities-div">
    {{^count_activities}}
    <p class="alert alert-info text-center">{{#str}}no_activities, enrol_select{{/str}}</p>
    {{/count_activities}}

    {{#count_activities}}
    {{#show_tabs}}
    {{! Traite le cas lorsqu'il y a plusieurs formats de cours à afficher. }}
    <ul id="enrol-select-course-formats-tabs" class="nav nav-pills" role="tablist">
        {{#course_formats}}
        <li class="nav-item mx-1">
            <a class="border btn btn-light" href="#format-{{ id }}" role="tab" tabindex="-1">{{ name }}</a>
        </li>
        {{/course_formats}}
    </ul>

    <div aria-hidden="true" class="text-end"><button class="btn btn-sm btn-primary" data-action="show" id="apsolu-toggle-activities">Déplier/replier toutes les activités</button></div>

    <div id="enrol-select-course-formats-tab-content" class="tab-content">
        {{#course_formats}}
        <div id="format-{{ id }}">
            {{> enrol_select/overview_activities }}
        </div>
        {{/course_formats}}
    </div>
    {{/show_tabs}}

    {{^show_tabs}}
    {{! Traite le cas lorsqu'il n'y a qu'un seul format de cours à afficher. }}
    <div aria-hidden="true" class="text-end"><button class="btn btn-sm btn-primary" data-action="show" id="apsolu-toggle-activities">Déplier/replier toutes les activités</button></div>

    {{#course_formats}}
        {{> enrol_select/overview_activities }}
    {{/course_formats}}
    {{/show_tabs}}
    {{/count_activities}}

    <p class="mt-4 text-end"><a class="btn btn-primary" href="{{www_url}}/my/">{{#str}}back_to_dashboard, enrol_select{{/str}}</a></p>
</div>
